        <bpmn:documentation>presnick/mi-spending:scripts/compute_peer_stats.py: medians and mix percentages per entity type from the county's F65DATA extractions. Seconds, and no tokens.</bpmn:documentation>
        <bpmn:incoming>f_70</bpmn:incoming>
        <bpmn:outgoing>f_71</bpmn:outgoing>
        <bpmn:property id="Property_T_peer" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="di_174">
