        <bpmn:targetRef>Property_T_ci1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="G_ci1" name="check&#10;passed?" default="f_ci1_no">
      <bpmn:incoming>f_9</bpmn:incoming>
      <bpmn:outgoing>f_ci1_no</bpmn:outgoing>
      <bpmn:outgoing>f_ci1_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_c_w1">
      <bpmn:incoming>f_ci1_yes</bpmn:incoming>
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:incoming>f_d1_pending</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Catch_1" name="reached by a&#10;nightly run">
      <bpmn:documentation>Every nightly run re-reads every review file (presnick/mi-spending:.claude/skills/nightly-batch, Step 1c). Until a run gets here the county waits, however long that is.</bpmn:documentation>
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Catch_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="T_read1" name="Read the reporter&#39;s decision&#10;nightly-batch">
      <bpmn:documentation>presnick/mi-spending:.claude/skills/nightly-batch, Step 1d: reads extraction-review.md and every extraction-notes file for the county.</bpmn:documentation>
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
      <bpmn:property id="Property_T_read1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="di_137">
        <bpmn:sourceRef>DOR_xr_41</bpmn:sourceRef>
        <bpmn:targetRef>Property_T_read1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="di_138">
        <bpmn:sourceRef>DOR_en_42</bpmn:sourceRef>
        <bpmn:targetRef>Property_T_read1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_d1" name="what did the&#10;reporter decide?" default="f_d1_pending">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_d1_pending</bpmn:outgoing>
      <bpmn:outgoing>f_d1_rerun</bpmn:outgoing>
      <bpmn:outgoing>f_d1_appr</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="T_cov" name="Recheck coverage, strictly&#10;check_extraction_coverage.py">
      <bpmn:documentation>presnick/mi-spending:scripts/check_extraction_coverage.py --strict (presnick/mi-spending:.claude/skills/nightly-batch, Step 1d). Exits 1 if any eligible PDF has no extraction, which means the approval was given on incomplete data.</bpmn:documentation>
      <bpmn:incoming>f_d1_appr</bpmn:incoming>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="G_c_rep">
      <bpmn:incoming>f_cov_yes</bpmn:incoming>
      <bpmn:incoming>f_d2_rerun</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub_reports" name="Generate reports">
      <bpmn:documentation>presnick/mi-spending:.claude/skills/nightly-batch, Step 3, phase generating_reports, and Step 6 for reruns. One subagent per entity; the plane below has the detail.</bpmn:documentation>
