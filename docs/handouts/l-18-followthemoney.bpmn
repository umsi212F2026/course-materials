<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_ftm" targetNamespace="http://si212.umich.edu/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="C_1">
    <bpmn:participant id="P_county" name="FollowTheMoney: one county, from the queue to the public site" processRef="Proc_county">
      <bpmn:documentation>presnick/mi-spending:README.md. One run is one county, across as many nights as its two reporter gates take. Michigan has 83 counties; each is its own run.</bpmn:documentation>
      <bpmn:participantMultiplicity minimum="1" maximum="83" />
    </bpmn:participant>
    <bpmn:participant id="P_night" name="One nightly batch" processRef="Proc_night">
      <bpmn:documentation>presnick/mi-spending:.claude/skills/nightly-batch and presnick/mi-spending:docs/operations.md. One run is one night.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="mf_start" sourceRef="T_advance" targetRef="Start_county" />
    <bpmn:messageFlow id="mf_w1" sourceRef="T_advance" targetRef="Catch_1" />
    <bpmn:messageFlow id="mf_w2" sourceRef="T_advance" targetRef="Catch_2" />
  </bpmn:collaboration>
  <bpmn:dataStore id="DS_progress" name="pipeline_progress.json" />
  <bpmn:process id="Proc_county" name="One county" isExecutable="false">
    <bpmn:laneSet id="LS_Proc_county">
      <bpmn:lane id="L_c_p" name="PROGRAM">
        <bpmn:flowNodeRef>T_auto1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_notes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_xrev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_push1b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ci1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_cov</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_flag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_push2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_push2b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ci2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_c_pub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_deploy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_c_a" name="AI AGENT">
        <bpmn:flowNodeRef>Start_county</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_c_ext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_push1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_c_w1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_read1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_c_rep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_auto2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_c_w2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_read2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_d2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_county</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_extract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_reports</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_cov</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_c_h" name="HUMAN operator">
        <bpmn:flowNodeRef>G_c_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ci1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_c_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ci2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_gate1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_gate2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_county" name="reached in&#10;the queue">
      <bpmn:documentation>A county starts when a nightly run reaches it in county_queue (presnick/mi-spending:.claude/skills/nightly-batch, Step 2). The queue lives in presnick/mi-spending:data/state/pipeline_progress.json; a person adds a county by appending its code.</bpmn:documentation>
      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_county" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G_c_ext">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:incoming>f_d1_rerun</bpmn:incoming>
      <bpmn:incoming>f_cov_no</bpmn:incoming>
      <bpmn:outgoing>f_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="T_push1" name="Push for review&#10;git push">
      <bpmn:documentation>presnick/mi-spending:.claude/skills/nightly-batch, Step 4c: commit review/ and extraction-notes/ and push to origin/main, where reporters work in the GitHub web UI. Nothing notifies them; they find waiting counties in presnick/mi-spending:review/pipeline-status.md.</bpmn:documentation>
      <bpmn:incoming>f_f1_yes</bpmn:incoming>
      <bpmn:outgoing>f_6</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="T_auto1" name="Approve it automatically&#10;nightly-batch">
      <bpmn:documentation>presnick/mi-spending:.claude/skills/nightly-batch, Step 4b: if nothing is flagged and nothing has warnings, the orchestrator sets the review file to approved itself.</bpmn:documentation>
      <bpmn:incoming>f_f1_no</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="do_132">
        <bpmn:targetRef>DOR_xr_36</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:subProcess id="Sub_extract" name="Extract documents">
      <bpmn:documentation>presnick/mi-spending:.claude/skills/nightly-batch, Step 3, phase not_started or extracting, and Step 6 for reruns. One subagent per document; the plane below has the detail.</bpmn:documentation>
      <bpmn:incoming>f_2</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
      <bpmn:property id="Property_Sub_extract" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="di_125">
        <bpmn:sourceRef>DOR_pdf_31</bpmn:sourceRef>
        <bpmn:targetRef>Property_Sub_extract</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="di_126">
        <bpmn:sourceRef>DOR_en_32</bpmn:sourceRef>
        <bpmn:targetRef>Property_Sub_extract</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="do_127">
        <bpmn:targetRef>DOR_json_33</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:laneSet id="LS_Sub_extract">
        <bpmn:lane id="L_x_p" name="PROGRAM">
          <bpmn:flowNodeRef>T_xcov</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="L_x_a" name="AI AGENT">
          <bpmn:flowNodeRef>T_clear</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_x_m</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_queue</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_extract</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Start_x</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_q</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_x</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_xcov</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="Start_x" name="county&#39;s turn&#10;to extract">
        <bpmn:outgoing>f_56</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="T_clear" name="Delete JSONs marked rerun&#10;nightly-batch">
        <bpmn:documentation>presnick/mi-spending:.claude/skills/nightly-batch, Step 6: for each extraction-notes file marked rerun, delete that document's JSON so the queue picks it up again. The notes file stays, carrying the reporter's note into the prompt.</bpmn:documentation>
        <bpmn:incoming>f_56</bpmn:incoming>
        <bpmn:outgoing>f_57</bpmn:outgoing>
        <bpmn:property id="Property_T_clear" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="di_156">
          <bpmn:sourceRef>DOR_en_62</bpmn:sourceRef>
          <bpmn:targetRef>Property_T_clear</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_x_m">
        <bpmn:incoming>f_57</bpmn:incoming>
        <bpmn:incoming>f_q_yes</bpmn:incoming>
        <bpmn:incoming>f_xcov_yes</bpmn:incoming>
        <bpmn:outgoing>f_58</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_queue" name="Build the extraction queue&#10;nightly-batch">
        <bpmn:documentation>presnick/mi-spending:.claude/skills/nightly-batch, Step 3, Build queue: every extractable PDF for the county's active entity types, newest two fiscal years, minus those that already have a JSON. Prints a count per document type.</bpmn:documentation>
        <bpmn:incoming>f_58</bpmn:incoming>
        <bpmn:outgoing>f_59</bpmn:outgoing>
        <bpmn:property id="Property_T_queue" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="di_q1">
          <bpmn:sourceRef>DOR_pdf_q</bpmn:sourceRef>
          <bpmn:targetRef>Property_T_queue</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="di_q2">
          <bpmn:sourceRef>DOR_json_q</bpmn:sourceRef>
          <bpmn:targetRef>Property_T_queue</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="do_q">
          <bpmn:targetRef>DOR_queue</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_q" name="a type left out&#10;of the queue?" default="f_q_no">
        <bpmn:incoming>f_59</bpmn:incoming>
        <bpmn:outgoing>f_q_yes</bpmn:outgoing>
        <bpmn:outgoing>f_q_no</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_extract" name="Extract each queued document&#10;extract-document">
        <bpmn:documentation>A fresh Sonnet subagent per document, run one at a time, from the inline prompt in presnick/mi-spending:.claude/skills/nightly-batch, Step 3, which follows presnick/mi-spending:.claude/skills/extract-document. The orchestrator pastes the schema and the editor notes into the prompt rather than passing paths. On something the schema does not cover, it halts: writes what it could, with halted: true, plus a review request with a suggested schema addition. Stops when the session budget runs low; the next night skips every document that already has a JSON.</bpmn:documentation>
        <bpmn:incoming>f_q_no</bpmn:incoming>
        <bpmn:outgoing>f_60</bpmn:outgoing>
        <bpmn:property id="Property_T_extract" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="di_q3">
          <bpmn:sourceRef>DOR_queue</bpmn:sourceRef>
          <bpmn:targetRef>Property_T_extract</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="di_157">
          <bpmn:sourceRef>DOR_pdf_63</bpmn:sourceRef>
          <bpmn:targetRef>Property_T_extract</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="di_158">
          <bpmn:sourceRef>DOR_schema_64</bpmn:sourceRef>
          <bpmn:targetRef>Property_T_extract</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="di_159">
          <bpmn:sourceRef>DOR_en_65</bpmn:sourceRef>
          <bpmn:targetRef>Property_T_extract</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="do_160">
          <bpmn:targetRef>DOR_json_66</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:dataOutputAssociation id="do_161">
          <bpmn:targetRef>DOR_rq_67</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      </bpmn:serviceTask>
      <bpmn:scriptTask id="T_xcov" name="Check coverage&#10;check_extraction_coverage.py">
        <bpmn:documentation>presnick/mi-spending:scripts/check_extraction_coverage.py (presnick/mi-spending:.claude/skills/nightly-batch, Step 4-pre). Exits 1 if a whole document type has no extractions although its PDFs are on disk.</bpmn:documentation>
        <bpmn:incoming>f_60</bpmn:incoming>
        <bpmn:outgoing>f_61</bpmn:outgoing>
        <bpmn:property id="Property_T_xcov" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="di_162">
          <bpmn:sourceRef>DOR_json_68</bpmn:sourceRef>
          <bpmn:targetRef>Property_T_xcov</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="G_xcov" name="a type with no&#10;JSONs at all?" default="f_xcov_no">
        <bpmn:incoming>f_61</bpmn:incoming>
        <bpmn:outgoing>f_xcov_yes</bpmn:outgoing>
        <bpmn:outgoing>f_xcov_no</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_x" name="every eligible&#10;PDF has a JSON">
        <bpmn:incoming>f_xcov_no</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:dataObject id="DO_queue" isCollection="true" />
      <bpmn:dataObjectReference id="DOR_pdf_q" name="Treasury PDFs" dataObjectRef="DO_pdf" />
      <bpmn:dataObjectReference id="DOR_json_q" name="extraction JSONs" dataObjectRef="DO_json" />
      <bpmn:dataObjectReference id="DOR_queue" name="extraction queue" dataObjectRef="DO_queue" />
      <bpmn:dataObjectReference id="DOR_en_62" name="extraction-notes&#10;[rerun]" dataObjectRef="DO_en">
        <bpmn:dataState id="State_DOR_en_62" name="rerun" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="DOR_pdf_63" name="Treasury PDFs" dataObjectRef="DO_pdf" />
      <bpmn:dataObjectReference id="DOR_schema_64" name="extraction schema" dataObjectRef="DO_schema" />
      <bpmn:dataObjectReference id="DOR_en_65" name="extraction-notes" dataObjectRef="DO_en" />
      <bpmn:dataObjectReference id="DOR_json_66" name="extraction JSONs" dataObjectRef="DO_json" />
      <bpmn:dataObjectReference id="DOR_rq_67" name="halt review request" dataObjectRef="DO_rq" />
      <bpmn:dataObjectReference id="DOR_json_68" name="extraction JSONs" dataObjectRef="DO_json" />
      <bpmn:sequenceFlow id="f_56" sourceRef="Start_x" targetRef="T_clear" />
      <bpmn:sequenceFlow id="f_57" sourceRef="T_clear" targetRef="G_x_m" />
      <bpmn:sequenceFlow id="f_58" sourceRef="G_x_m" targetRef="T_queue" />
      <bpmn:sequenceFlow id="f_59" sourceRef="T_queue" targetRef="G_q" />
      <bpmn:sequenceFlow id="f_q_yes" name="yes" sourceRef="G_q" targetRef="G_x_m">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">a type has PDFs on disk without a JSON, and a count of 0</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="f_q_no" name="no" sourceRef="G_q" targetRef="T_extract" />
      <bpmn:sequenceFlow id="f_60" sourceRef="T_extract" targetRef="T_xcov" />
      <bpmn:sequenceFlow id="f_61" sourceRef="T_xcov" targetRef="G_xcov" />
      <bpmn:sequenceFlow id="f_xcov_yes" name="yes" sourceRef="G_xcov" targetRef="G_x_m">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">check_extraction_coverage.py exited 1</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="f_xcov_no" name="no" sourceRef="G_xcov" targetRef="End_x" />
      <bpmn:dataObject id="DO_pdf" isCollection="true" />
      <bpmn:dataObject id="DO_en" isCollection="true" />
      <bpmn:dataObject id="DO_schema" />
      <bpmn:dataObject id="DO_rq" />
    </bpmn:subProcess>
    <bpmn:scriptTask id="T_notes" name="Validate every extraction&#10;write_extraction_notes.py">
      <bpmn:documentation>presnick/mi-spending:scripts/write_extraction_notes.py (presnick/mi-spending:.claude/skills/nightly-batch, Step 4a). Re-validates every extraction JSON and writes its extraction-notes file, status ok or error. Archives the previous notes file by copying it to .v{n}.md first.</bpmn:documentation>
      <bpmn:incoming>f_3</bpmn:incoming>
      <bpmn:outgoing>f_4</bpmn:outgoing>
      <bpmn:property id="Property_T_notes" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="di_128">
        <bpmn:sourceRef>DOR_json_33</bpmn:sourceRef>
        <bpmn:targetRef>Property_T_notes</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="do_129">
        <bpmn:targetRef>DOR_en_34</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="T_xrev" name="Summarize for the reporter&#10;write_extraction_review.py">
      <bpmn:documentation>presnick/mi-spending:scripts/write_extraction_review.py (presnick/mi-spending:.claude/skills/nightly-batch, Step 4b). Reads every extraction-notes file and writes review/{County}/extraction-review.md: Flagged, Warnings only, Clean, with status: pending.</bpmn:documentation>
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
      <bpmn:property id="Property_T_xrev" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="di_130">
        <bpmn:sourceRef>DOR_en_34</bpmn:sourceRef>
        <bpmn:targetRef>Property_T_xrev</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="do_131">
        <bpmn:targetRef>DOR_xr_35</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="G_f1" name="anything&#10;flagged?">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_f1_yes</bpmn:outgoing>
      <bpmn:outgoing>f_f1_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="T_push1b" name="Push for review&#10;git push">
      <bpmn:documentation>presnick/mi-spending:.claude/skills/nightly-batch, Step 4c: the same commit and push as on the flagged path.</bpmn:documentation>
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="G_c_g1">
      <bpmn:incoming>f_6</bpmn:incoming>
      <bpmn:incoming>f_ci1_no</bpmn:incoming>
      <bpmn:outgoing>f_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub_gate1" name="Review extractions&#10;(Gate 1)">
      <bpmn:documentation>presnick/mi-spending:docs/reporter-guide.md, Gate 1. Done entirely in the GitHub web UI.</bpmn:documentation>
      <bpmn:incoming>f_7</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:property id="Property_Sub_gate1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="di_133">
        <bpmn:sourceRef>DOR_json_37</bpmn:sourceRef>
        <bpmn:targetRef>Property_Sub_gate1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="do_134">
        <bpmn:targetRef>DOR_en_38</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="do_135">
        <bpmn:targetRef>DOR_xr_39</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:laneSet id="LS_Sub_gate1">
        <bpmn:lane id="L_g1_h" name="HUMAN operator">
          <bpmn:flowNodeRef>Start_g1</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_g1_skim</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_g1_m</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_g1_inv</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_g1_what</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_g1_rerun</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_g1_accept</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_g1_esc</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_g1_j</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_g1_more</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_g1_any</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_g1_appr</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_g1_k</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_g1_commit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_g1</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="Start_g1" name="extraction&#10;review pushed">
        <bpmn:outgoing>f_83</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="T_g1_skim" name="Skim the review file">
        <bpmn:documentation>presnick/mi-spending:docs/reporter-guide.md, Gate 1: Extraction review. Step 1.</bpmn:documentation>
        <bpmn:incoming>f_83</bpmn:incoming>
        <bpmn:outgoing>f_84</bpmn:outgoing>
        <bpmn:property id="Property_T_g1_skim" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="di_163">
