        </bpmn:dataInputAssociation>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_g1_m">
        <bpmn:incoming>f_84</bpmn:incoming>
        <bpmn:incoming>f_g1_more_yes</bpmn:incoming>
        <bpmn:outgoing>f_85</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_g1_inv" name="Investigate a flagged document">
        <bpmn:documentation>presnick/mi-spending:docs/reporter-guide.md, Gate 1: Extraction review. Step 2.</bpmn:documentation>
        <bpmn:incoming>f_85</bpmn:incoming>
        <bpmn:outgoing>f_86</bpmn:outgoing>
        <bpmn:property id="Property_T_g1_inv" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="di_164">
          <bpmn:sourceRef>DOR_en_95</bpmn:sourceRef>
          <bpmn:targetRef>Property_T_g1_inv</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="di_165">
          <bpmn:sourceRef>DOR_json_96</bpmn:sourceRef>
