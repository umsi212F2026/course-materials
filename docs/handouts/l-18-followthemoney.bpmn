      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="DOR_rr_115" name="report-review.md&#10;[approved]" dataObjectRef="DO_rr">
        <bpmn:dataState id="State_DOR_rr_115" name="approved" />
      </bpmn:dataObjectReference>
      <bpmn:sequenceFlow id="f_101" sourceRef="Start_g2" targetRef="T_g2_skim" />
      <bpmn:sequenceFlow id="f_102" sourceRef="T_g2_skim" targetRef="G_g2_m" />
      <bpmn:sequenceFlow id="f_103" sourceRef="G_g2_m" targetRef="T_g2_inv" />
      <bpmn:sequenceFlow id="f_104" sourceRef="T_g2_inv" targetRef="G_g2_what" />
      <bpmn:sequenceFlow id="f_g2_rerun" name="regenerate" sourceRef="G_g2_what" targetRef="T_g2_rerun">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">local knowledge or a correction would change the report</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="f_105" sourceRef="T_g2_rerun" targetRef="G_g2_j" />
      <bpmn:sequenceFlow id="f_g2_accept" name="accept" sourceRef="G_g2_what" targetRef="T_g2_accept" />
      <bpmn:sequenceFlow id="f_106" sourceRef="T_g2_accept" targetRef="G_g2_j" />
      <bpmn:sequenceFlow id="f_107" sourceRef="G_g2_j" targetRef="G_g2_more" />
      <bpmn:sequenceFlow id="f_g2_more_yes" name="yes" sourceRef="G_g2_more" targetRef="G_g2_m">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">another flagged item is unreviewed</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="f_g2_more_no" name="no" sourceRef="G_g2_more" targetRef="G_g2_any" />
      <bpmn:sequenceFlow id="f_g2_any_yes" name="yes" sourceRef="G_g2_any" targetRef="G_g2_k">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">some notes file says status: rerun</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="f_g2_any_no" name="no" sourceRef="G_g2_any" targetRef="T_g2_appr" />
      <bpmn:sequenceFlow id="f_108" sourceRef="T_g2_appr" targetRef="G_g2_k" />
      <bpmn:sequenceFlow id="f_109" sourceRef="G_g2_k" targetRef="T_g2_commit" />
      <bpmn:sequenceFlow id="f_110" sourceRef="T_g2_commit" targetRef="End_g2" />
    </bpmn:subProcess>
    <bpmn:scriptTask id="T_ci2" name="Check the reporter&#39;s edits&#10;validate_review.py">
