      <bpmn:exclusiveGateway id="G_g2_j">
        <bpmn:incoming>f_105</bpmn:incoming>
        <bpmn:incoming>f_106</bpmn:incoming>
        <bpmn:outgoing>f_107</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="G_g2_more" name="more flagged&#10;reports?" default="f_g2_more_no">
        <bpmn:incoming>f_107</bpmn:incoming>
        <bpmn:outgoing>f_g2_more_yes</bpmn:outgoing>
        <bpmn:outgoing>f_g2_more_no</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="G_g2_any" name="any marked&#10;rerun?" default="f_g2_any_no">
        <bpmn:incoming>f_g2_more_no</bpmn:incoming>
        <bpmn:outgoing>f_g2_any_yes</bpmn:outgoing>
        <bpmn:outgoing>f_g2_any_no</bpmn:outgoing>
