        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="di_166">
          <bpmn:sourceRef>DOR_pdf_97</bpmn:sourceRef>
          <bpmn:targetRef>Property_T_g1_inv</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_g1_what" name="what should&#10;happen to it?" default="f_g1_esc">
        <bpmn:incoming>f_86</bpmn:incoming>
        <bpmn:outgoing>f_g1_rerun</bpmn:outgoing>
        <bpmn:outgoing>f_g1_accept</bpmn:outgoing>
        <bpmn:outgoing>f_g1_esc</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_g1_rerun" name="Mark it rerun, with a note">
        <bpmn:documentation>presnick/mi-spending:docs/reporter-guide.md, Gate 1: Extraction review. Step 3, Re-extract.</bpmn:documentation>
        <bpmn:incoming>f_g1_rerun</bpmn:incoming>
        <bpmn:outgoing>f_87</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="do_167">
          <bpmn:targetRef>DOR_en_98</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:userTask>
      <bpmn:userTask id="T_g1_accept" name="Accept the flag, with a note">
        <bpmn:documentation>presnick/mi-spending:docs/reporter-guide.md, Gate 1: Extraction review. Step 3, Accept the flag.</bpmn:documentation>
        <bpmn:incoming>f_g1_accept</bpmn:incoming>
        <bpmn:outgoing>f_88</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="do_168">
          <bpmn:targetRef>DOR_en_99</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:userTask>
      <bpmn:userTask id="T_g1_esc" name="Note what you checked, escalate">
        <bpmn:documentation>presnick/mi-spending:docs/reporter-guide.md, Gate 1: Extraction review. Step 3, Escalate. A halted extraction always lands here: the schema needs a fix first.</bpmn:documentation>
        <bpmn:incoming>f_g1_esc</bpmn:incoming>
        <bpmn:outgoing>f_89</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="do_169">
          <bpmn:targetRef>DOR_en_99</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_g1_j">
        <bpmn:incoming>f_87</bpmn:incoming>
        <bpmn:incoming>f_88</bpmn:incoming>
        <bpmn:incoming>f_89</bpmn:incoming>
        <bpmn:outgoing>f_90</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="G_g1_more" name="more flagged&#10;documents?" default="f_g1_more_no">
        <bpmn:incoming>f_90</bpmn:incoming>
        <bpmn:outgoing>f_g1_more_yes</bpmn:outgoing>
        <bpmn:outgoing>f_g1_more_no</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="G_g1_any" name="any marked&#10;rerun?" default="f_g1_any_no">
        <bpmn:incoming>f_g1_more_no</bpmn:incoming>
        <bpmn:outgoing>f_g1_any_yes</bpmn:outgoing>
        <bpmn:outgoing>f_g1_any_no</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_g1_appr" name="Set the review approved">
        <bpmn:documentation>presnick/mi-spending:docs/reporter-guide.md, Gate 1: Extraction review. The approval step: only when nothing is marked rerun.</bpmn:documentation>
        <bpmn:incoming>f_g1_any_no</bpmn:incoming>
        <bpmn:outgoing>f_91</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="do_170">
          <bpmn:targetRef>DOR_xr_100</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_g1_k">
        <bpmn:incoming>f_g1_any_yes</bpmn:incoming>
        <bpmn:incoming>f_91</bpmn:incoming>
        <bpmn:outgoing>f_92</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_g1_commit" name="Commit on GitHub">
        <bpmn:documentation>presnick/mi-spending:docs/reporter-guide.md, Gate 1: Extraction review. Edits are made and committed in the GitHub web UI, straight to main.</bpmn:documentation>
        <bpmn:incoming>f_92</bpmn:incoming>
        <bpmn:outgoing>f_93</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="End_g1" name="decision&#10;committed">
        <bpmn:incoming>f_93</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:dataObjectReference id="DOR_xr_94" name="extraction-review.md&#10;[pending]" dataObjectRef="DO_xr">
        <bpmn:dataState id="State_DOR_xr_94" name="pending" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="DOR_en_95" name="extraction-notes&#10;[error]" dataObjectRef="DO_en">
        <bpmn:dataState id="State_DOR_en_95" name="error" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="DOR_json_96" name="extraction JSONs" dataObjectRef="DO_json" />
      <bpmn:dataObjectReference id="DOR_pdf_97" name="Treasury PDFs" dataObjectRef="DO_pdf" />
      <bpmn:dataObjectReference id="DOR_en_98" name="extraction-notes&#10;[rerun]" dataObjectRef="DO_en">
        <bpmn:dataState id="State_DOR_en_98" name="rerun" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="DOR_en_99" name="extraction-notes&#10;[error]" dataObjectRef="DO_en">
        <bpmn:dataState id="State_DOR_en_99" name="error" />
      </bpmn:dataObjectReference>
      <bpmn:dataObjectReference id="DOR_xr_100" name="extraction-review.md&#10;[approved]" dataObjectRef="DO_xr">
        <bpmn:dataState id="State_DOR_xr_100" name="approved" />
      </bpmn:dataObjectReference>
      <bpmn:sequenceFlow id="f_83" sourceRef="Start_g1" targetRef="T_g1_skim" />
      <bpmn:sequenceFlow id="f_84" sourceRef="T_g1_skim" targetRef="G_g1_m" />
      <bpmn:sequenceFlow id="f_85" sourceRef="G_g1_m" targetRef="T_g1_inv" />
      <bpmn:sequenceFlow id="f_86" sourceRef="T_g1_inv" targetRef="G_g1_what" />
      <bpmn:sequenceFlow id="f_g1_rerun" name="re-extract" sourceRef="G_g1_what" targetRef="T_g1_rerun">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">the extraction is wrong and a note can say how</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="f_87" sourceRef="T_g1_rerun" targetRef="G_g1_j" />
      <bpmn:sequenceFlow id="f_g1_accept" name="accept" sourceRef="G_g1_what" targetRef="T_g1_accept">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">the flag is explained, e.g. the PDF itself rounds</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="f_88" sourceRef="T_g1_accept" targetRef="G_g1_j" />
      <bpmn:sequenceFlow id="f_g1_esc" name="can&#39;t tell" sourceRef="G_g1_what" targetRef="T_g1_esc" />
      <bpmn:sequenceFlow id="f_89" sourceRef="T_g1_esc" targetRef="G_g1_j" />
      <bpmn:sequenceFlow id="f_90" sourceRef="G_g1_j" targetRef="G_g1_more" />
      <bpmn:sequenceFlow id="f_g1_more_yes" name="yes" sourceRef="G_g1_more" targetRef="G_g1_m">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">another flagged item is unreviewed</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="f_g1_more_no" name="no" sourceRef="G_g1_more" targetRef="G_g1_any" />
      <bpmn:sequenceFlow id="f_g1_any_yes" name="yes" sourceRef="G_g1_any" targetRef="G_g1_k">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">some notes file says status: rerun</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="f_g1_any_no" name="no" sourceRef="G_g1_any" targetRef="T_g1_appr" />
      <bpmn:sequenceFlow id="f_91" sourceRef="T_g1_appr" targetRef="G_g1_k" />
      <bpmn:sequenceFlow id="f_92" sourceRef="G_g1_k" targetRef="T_g1_commit" />
      <bpmn:sequenceFlow id="f_93" sourceRef="T_g1_commit" targetRef="End_g1" />
    </bpmn:subProcess>
    <bpmn:scriptTask id="T_ci1" name="Check the reporter&#39;s edits&#10;validate_review.py">
      <bpmn:documentation>presnick/mi-spending:.github/workflows/validate-review.yml runs presnick/mi-spending:scripts/validate_review.py on every push that touches review/ or the notes. It rejects a review file set to approved while any notes file in that county is still marked rerun.</bpmn:documentation>
      <bpmn:incoming>f_8</bpmn:incoming>
      <bpmn:outgoing>f_9</bpmn:outgoing>
      <bpmn:property id="Property_T_ci1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="di_136">
