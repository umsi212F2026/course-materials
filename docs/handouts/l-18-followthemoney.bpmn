      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="do_143">
        <bpmn:targetRef>DOR_rr_46</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="G_f2" name="anything&#10;flagged?">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_f2_yes</bpmn:outgoing>
      <bpmn:outgoing>f_f2_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="T_push2" name="Push for review&#10;git push">
      <bpmn:documentation>presnick/mi-spending:.claude/skills/nightly-batch, Step 3 (generating_reports, when all reports are generated): commit review/, report-notes/ and reports/ and push to origin/main.</bpmn:documentation>
      <bpmn:incoming>f_f2_yes</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="T_auto2" name="Approve it automatically&#10;nightly-batch">
      <bpmn:documentation>presnick/mi-spending:.claude/skills/nightly-batch, Step 5: if no entity is flagged, the orchestrator sets report-review.md to approved itself.</bpmn:documentation>
      <bpmn:incoming>f_f2_no</bpmn:incoming>
      <bpmn:outgoing>f_23</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="do_144">
        <bpmn:targetRef>DOR_rr_47</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="T_push2b" name="Push for review&#10;git push">
      <bpmn:documentation>presnick/mi-spending:.claude/skills/nightly-batch, Step 3: the same commit and push as on the flagged path.</bpmn:documentation>
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="G_c_g2">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:incoming>f_ci2_no</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub_gate2" name="Review reports&#10;(Gate 2)">
      <bpmn:documentation>presnick/mi-spending:docs/reporter-guide.md, Gate 2. Done entirely in the GitHub web UI.</bpmn:documentation>
