      </bpmn:dataObjectReference>
      <bpmn:sequenceFlow id="f_69" sourceRef="Start_r" targetRef="T_rclear" />
      <bpmn:sequenceFlow id="f_70" sourceRef="T_rclear" targetRef="T_peer" />
      <bpmn:sequenceFlow id="f_71" sourceRef="T_peer" targetRef="T_meth" />
      <bpmn:sequenceFlow id="f_72" sourceRef="T_meth" targetRef="T_report" />
      <bpmn:sequenceFlow id="f_73" sourceRef="T_report" targetRef="T_rnotes" />
      <bpmn:sequenceFlow id="f_74" sourceRef="T_rnotes" targetRef="End_r" />
      <bpmn:dataObject id="DO_rn" isCollection="true" />
      <bpmn:dataObject id="DO_peer" />
      <bpmn:dataObject id="DO_json" isCollection="true" />
      <bpmn:dataObject id="DO_rules" />
      <bpmn:dataObject id="DO_rep" isCollection="true" />
    </bpmn:subProcess>
    <bpmn:scriptTask id="T_flag" name="Flag reports for review&#10;write_report_review.py">
      <bpmn:documentation>presnick/mi-spending:scripts/write_report_review.py (presnick/mi-spending:.claude/skills/nightly-batch, Step 5). Flags a report whose extraction had errors, that has one fiscal year, that lacks AUD or an expected F65DATA, or whose newest data is over two years old. Writes report-review.md with status: pending.</bpmn:documentation>
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
      <bpmn:property id="Property_T_flag" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="di_142">
