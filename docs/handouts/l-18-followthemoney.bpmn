        <bpmn:dataInputAssociation id="di_176">
          <bpmn:sourceRef>DOR_rules_79</bpmn:sourceRef>
          <bpmn:targetRef>Property_T_report</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="di_177">
          <bpmn:sourceRef>DOR_rn_80</bpmn:sourceRef>
          <bpmn:targetRef>Property_T_report</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="do_178">
          <bpmn:targetRef>DOR_rep_81</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_rnotes" name="Write report-notes files&#10;nightly-batch">
        <bpmn:documentation>presnick/mi-spending:.claude/skills/nightly-batch, Step 3: one report-notes file per entity, status: ok, from the template there. An existing Reporter Notes section is kept verbatim; the notes are cumulative.</bpmn:documentation>
        <bpmn:incoming>f_73</bpmn:incoming>
        <bpmn:outgoing>f_74</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="do_179">
          <bpmn:targetRef>DOR_rn_82</bpmn:targetRef>
