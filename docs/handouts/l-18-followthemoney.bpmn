      <bpmn:dataObjectReference id="DOR_peer_76" name="peer statistics" dataObjectRef="DO_peer" />
      <bpmn:dataObjectReference id="DOR_json_77" name="extraction JSONs" dataObjectRef="DO_json" />
      <bpmn:dataObjectReference id="DOR_json_78" name="extraction JSONs" dataObjectRef="DO_json" />
      <bpmn:dataObjectReference id="DOR_rules_79" name="report-generation rules" dataObjectRef="DO_rules" />
      <bpmn:dataObjectReference id="DOR_rn_80" name="report-notes" dataObjectRef="DO_rn" />
      <bpmn:dataObjectReference id="DOR_rep_81" name="reports" dataObjectRef="DO_rep" />
