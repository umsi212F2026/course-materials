      <bpmn:dataInputAssociation id="di_145">
        <bpmn:sourceRef>DOR_rep_48</bpmn:sourceRef>
        <bpmn:targetRef>Property_Sub_gate2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="do_146">
        <bpmn:targetRef>DOR_rn_49</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="do_147">
        <bpmn:targetRef>DOR_rr_50</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:laneSet id="LS_Sub_gate2">
        <bpmn:lane id="L_g2_h" name="HUMAN operator">
          <bpmn:flowNodeRef>Start_g2</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_g2_skim</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_g2_m</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_g2_inv</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_g2_what</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_g2_rerun</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_g2_accept</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_g2_j</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_g2_more</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_g2_any</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_g2_appr</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_g2_k</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>T_g2_commit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_g2</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="Start_g2" name="report review&#10;pushed">
        <bpmn:outgoing>f_101</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="T_g2_skim" name="Skim the report review">
        <bpmn:documentation>presnick/mi-spending:docs/reporter-guide.md, Gate 2: Report review. Step 1.</bpmn:documentation>
        <bpmn:incoming>f_101</bpmn:incoming>
        <bpmn:outgoing>f_102</bpmn:outgoing>
        <bpmn:property id="Property_T_g2_skim" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="di_180">
          <bpmn:sourceRef>DOR_rr_111</bpmn:sourceRef>
          <bpmn:targetRef>Property_T_g2_skim</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_g2_m">
        <bpmn:incoming>f_102</bpmn:incoming>
        <bpmn:incoming>f_g2_more_yes</bpmn:incoming>
        <bpmn:outgoing>f_103</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_g2_inv" name="Read a flagged report">
        <bpmn:documentation>presnick/mi-spending:docs/reporter-guide.md, Gate 2: Report review. Step 2.</bpmn:documentation>
        <bpmn:incoming>f_103</bpmn:incoming>
        <bpmn:outgoing>f_104</bpmn:outgoing>
        <bpmn:property id="Property_T_g2_inv" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="di_181">
          <bpmn:sourceRef>DOR_rep_112</bpmn:sourceRef>
          <bpmn:targetRef>Property_T_g2_inv</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="di_182">
          <bpmn:sourceRef>DOR_rn_113</bpmn:sourceRef>
          <bpmn:targetRef>Property_T_g2_inv</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_g2_what" name="does it need&#10;regenerating?" default="f_g2_accept">
        <bpmn:incoming>f_104</bpmn:incoming>
        <bpmn:outgoing>f_g2_rerun</bpmn:outgoing>
        <bpmn:outgoing>f_g2_accept</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_g2_rerun" name="Add Reporter Notes, mark it rerun">
        <bpmn:documentation>presnick/mi-spending:docs/reporter-guide.md, Gate 2: Report review. Regenerate the report.</bpmn:documentation>
        <bpmn:incoming>f_g2_rerun</bpmn:incoming>
        <bpmn:outgoing>f_105</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="do_183">
          <bpmn:targetRef>DOR_rn_114</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:userTask>
      <bpmn:userTask id="T_g2_accept" name="Add context, accept it as is">
        <bpmn:documentation>presnick/mi-spending:docs/reporter-guide.md, Gate 2: Report review. Accept as-is; the note stays as context.</bpmn:documentation>
        <bpmn:incoming>f_g2_accept</bpmn:incoming>
        <bpmn:outgoing>f_106</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="do_184">
          <bpmn:targetRef>DOR_rn_acc</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
