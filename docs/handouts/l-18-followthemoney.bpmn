        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="Start_r" name="county&#39;s turn&#10;for reports">
        <bpmn:outgoing>f_69</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="T_rclear" name="Delete reports marked rerun&#10;nightly-batch">
        <bpmn:documentation>presnick/mi-spending:.claude/skills/nightly-batch, Step 6: for each report-notes file marked rerun, delete that entity's report so it is generated again with the reporter's notes in the prompt.</bpmn:documentation>
        <bpmn:incoming>f_69</bpmn:incoming>
        <bpmn:outgoing>f_70</bpmn:outgoing>
