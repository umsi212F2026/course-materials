      <bpmn:userTask id="T_g2_appr" name="Set the review approved">
        <bpmn:documentation>presnick/mi-spending:docs/reporter-guide.md, Gate 2: Report review. The approval step: only when nothing is marked rerun.</bpmn:documentation>
        <bpmn:incoming>f_g2_any_no</bpmn:incoming>
        <bpmn:outgoing>f_108</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="do_185">
          <bpmn:targetRef>DOR_rr_115</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_g2_k">
        <bpmn:incoming>f_g2_any_yes</bpmn:incoming>
        <bpmn:incoming>f_108</bpmn:incoming>
        <bpmn:outgoing>f_109</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_g2_commit" name="Commit on GitHub">
        <bpmn:documentation>presnick/mi-spending:docs/reporter-guide.md, Gate 2: Report review. Edits are made and committed in the GitHub web UI, straight to main.</bpmn:documentation>
        <bpmn:incoming>f_109</bpmn:incoming>
        <bpmn:outgoing>f_110</bpmn:outgoing>
      </bpmn:userTask>
