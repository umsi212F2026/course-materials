        <bpmn:dataOutputAssociation id="do_172">
          <bpmn:targetRef>DOR_peer_76</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="T_meth" name="Snapshot the methodology&#10;snapshot_methodology.py">
        <bpmn:documentation>presnick/mi-spending:scripts/snapshot_methodology.py --quiet: prints a 12-character id for the current report rules, archiving them if they changed. Every report is stamped with it.</bpmn:documentation>
        <bpmn:incoming>f_71</bpmn:incoming>
        <bpmn:outgoing>f_72</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:serviceTask id="T_report" name="Write each entity&#39;s report&#10;generate-report">
        <bpmn:documentation>A fresh Sonnet subagent per entity without a report, from the inline prompt in presnick/mi-spending:.claude/skills/nightly-batch, Step 3, which follows presnick/mi-spending:.claude/skills/generate-report. The prompt carries the rules, the methodology id, the peer statistics and the reporter's notes as text.</bpmn:documentation>
        <bpmn:incoming>f_72</bpmn:incoming>
        <bpmn:outgoing>f_73</bpmn:outgoing>
        <bpmn:property id="Property_T_report" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="di_173">
          <bpmn:sourceRef>DOR_peer_76</bpmn:sourceRef>
