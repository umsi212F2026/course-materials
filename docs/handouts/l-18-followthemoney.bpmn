    </bpmn:dataObjectReference>
    <bpmn:dataObjectReference id="DOR_rr_54" name="report-review.md" dataObjectRef="DO_rr" />
    <bpmn:dataObject id="DO_rr" />
    <bpmn:dataObjectReference id="DOR_rn_55" name="report-notes" dataObjectRef="DO_rn" />
    <bpmn:sequenceFlow id="f_1" sourceRef="Start_county" targetRef="G_c_ext" />
    <bpmn:sequenceFlow id="f_d1_rerun" name="a document marked rerun" sourceRef="G_d1" targetRef="G_c_ext">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">review pending and an extraction-notes file says status: rerun</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_cov_no" name="no" sourceRef="G_cov" targetRef="G_c_ext">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">check_extraction_coverage.py --strict exited 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_2" sourceRef="G_c_ext" targetRef="Sub_extract" />
    <bpmn:sequenceFlow id="f_f1_yes" name="yes" sourceRef="G_f1" targetRef="T_push1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">something is flagged or has warnings</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_6" sourceRef="T_push1" targetRef="G_c_g1" />
    <bpmn:sequenceFlow id="f_f1_no" name="no" sourceRef="G_f1" targetRef="T_auto1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">nothing flagged and no warnings</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_10" sourceRef="T_auto1" targetRef="T_push1b" />
    <bpmn:sequenceFlow id="f_3" sourceRef="Sub_extract" targetRef="T_notes" />
    <bpmn:sequenceFlow id="f_4" sourceRef="T_notes" targetRef="T_xrev" />
    <bpmn:sequenceFlow id="f_5" sourceRef="T_xrev" targetRef="G_f1" />
    <bpmn:sequenceFlow id="f_11" sourceRef="T_push1b" targetRef="G_c_w1" />
    <bpmn:sequenceFlow id="f_ci1_no" name="no" sourceRef="G_ci1" targetRef="G_c_g1" />
    <bpmn:sequenceFlow id="f_7" sourceRef="G_c_g1" targetRef="Sub_gate1" />
    <bpmn:sequenceFlow id="f_8" sourceRef="Sub_gate1" targetRef="T_ci1" />
    <bpmn:sequenceFlow id="f_9" sourceRef="T_ci1" targetRef="G_ci1" />
    <bpmn:sequenceFlow id="f_ci1_yes" name="yes" sourceRef="G_ci1" targetRef="G_c_w1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">validate_review.py passed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_d1_pending" name="still pending" sourceRef="G_d1" targetRef="G_c_w1" />
    <bpmn:sequenceFlow id="f_12" sourceRef="G_c_w1" targetRef="Catch_1" />
    <bpmn:sequenceFlow id="f_13" sourceRef="Catch_1" targetRef="T_read1" />
    <bpmn:sequenceFlow id="f_14" sourceRef="T_read1" targetRef="G_d1" />
    <bpmn:sequenceFlow id="f_d1_appr" name="approved" sourceRef="G_d1" targetRef="T_cov">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">extraction-review.md says status: approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_15" sourceRef="T_cov" targetRef="G_cov" />
    <bpmn:sequenceFlow id="f_cov_yes" name="yes" sourceRef="G_cov" targetRef="G_c_rep" />
    <bpmn:sequenceFlow id="f_d2_rerun" name="a report marked rerun" sourceRef="G_d2" targetRef="G_c_rep">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">review pending and a report-notes file says status: rerun</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_16" sourceRef="G_c_rep" targetRef="Sub_reports" />
    <bpmn:sequenceFlow id="f_17" sourceRef="Sub_reports" targetRef="T_flag" />
    <bpmn:sequenceFlow id="f_18" sourceRef="T_flag" targetRef="G_f2" />
    <bpmn:sequenceFlow id="f_f2_yes" name="yes" sourceRef="G_f2" targetRef="T_push2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">some entity is flagged</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_f2_no" name="no" sourceRef="G_f2" targetRef="T_auto2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">no entity flagged</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_19" sourceRef="T_push2" targetRef="G_c_g2" />
    <bpmn:sequenceFlow id="f_23" sourceRef="T_auto2" targetRef="T_push2b" />
    <bpmn:sequenceFlow id="f_24" sourceRef="T_push2b" targetRef="G_c_pub" />
    <bpmn:sequenceFlow id="f_ci2_no" name="no" sourceRef="G_ci2" targetRef="G_c_g2" />
    <bpmn:sequenceFlow id="f_20" sourceRef="G_c_g2" targetRef="Sub_gate2" />
    <bpmn:sequenceFlow id="f_21" sourceRef="Sub_gate2" targetRef="T_ci2" />
    <bpmn:sequenceFlow id="f_22" sourceRef="T_ci2" targetRef="G_ci2" />
    <bpmn:sequenceFlow id="f_ci2_yes" name="yes" sourceRef="G_ci2" targetRef="G_c_pub">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">validate_review.py passed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_25" sourceRef="G_c_pub" targetRef="T_deploy" />
    <bpmn:sequenceFlow id="f_26" sourceRef="T_deploy" targetRef="G_c_w2" />
    <bpmn:sequenceFlow id="f_d2_pending" name="still pending" sourceRef="G_d2" targetRef="G_c_w2" />
    <bpmn:sequenceFlow id="f_27" sourceRef="G_c_w2" targetRef="Catch_2" />
    <bpmn:sequenceFlow id="f_28" sourceRef="Catch_2" targetRef="T_read2" />
    <bpmn:sequenceFlow id="f_29" sourceRef="T_read2" targetRef="G_d2" />
    <bpmn:sequenceFlow id="f_d2_appr" name="approved" sourceRef="G_d2" targetRef="T_done">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">report-review.md says status: approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_30" sourceRef="T_done" targetRef="End_county" />
    <bpmn:exclusiveGateway id="G_cov" name="every PDF&#10;extracted?" default="f_cov_yes">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_cov_no</bpmn:outgoing>
      <bpmn:outgoing>f_cov_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataObjectReference id="DOR_xr_39" name="extraction-review.md&#10;[pending or approved]" dataObjectRef="DO_xr">
      <bpmn:dataState id="State_DOR_xr_39" name="pending or approved" />
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DO_xr" />
  </bpmn:process>
  <bpmn:process id="Proc_night" name="One nightly batch" isExecutable="false">
    <bpmn:laneSet id="LS_Proc_night">
      <bpmn:lane id="L_n_p" name="PROGRAM">
        <bpmn:flowNodeRef>Start_night</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_launch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_clock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_skip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_pull</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_n_a" name="AI AGENT">
        <bpmn:flowNodeRef>G_ff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_n_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_advance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_dash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_night</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_night" name="midnight">
      <bpmn:documentation>presnick/mi-spending:docs/operations.md: a macOS LaunchAgent, com.followthemoney.nightly-batch, with StartCalendarInterval 00:00. It does not wake a sleeping Mac.</bpmn:documentation>
      <bpmn:outgoing>f_116</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Start_night">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">every day at 00:00 local time</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:scriptTask id="T_launch" name="Start the batch&#10;run-nightly-batch.sh">
      <bpmn:documentation>presnick/mi-spending:scripts/run-nightly-batch.sh, machine-local and untracked; reproduced in presnick/mi-spending:docs/operations.md. Runs claude -p "/nightly-batch --session-budget 100", logging to ~/Library/Logs/followthemoney/.</bpmn:documentation>
      <bpmn:incoming>f_116</bpmn:incoming>
      <bpmn:outgoing>f_117</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="G_clock" name="within the&#10;midnight hour?" default="f_clock_yes">
      <bpmn:incoming>f_117</bpmn:incoming>
      <bpmn:outgoing>f_clock_no</bpmn:outgoing>
      <bpmn:outgoing>f_clock_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_skip" name="night&#10;skipped">
      <bpmn:incoming>f_clock_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="T_pull" name="Pull the reporters&#39; commits&#10;git pull">
      <bpmn:documentation>presnick/mi-spending:.claude/skills/nightly-batch, Step 1a: git pull --ff-only. Reporters approve and mark reruns on origin/main through the GitHub web UI; this is the only way their edits reach the pipeline.</bpmn:documentation>
      <bpmn:incoming>f_clock_yes</bpmn:incoming>
      <bpmn:outgoing>f_118</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="G_ff" name="fast-&#10;forward?" default="f_ff_yes">
      <bpmn:incoming>f_118</bpmn:incoming>
      <bpmn:outgoing>f_ff_no</bpmn:outgoing>
      <bpmn:outgoing>f_ff_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_conflict" name="stopped on&#10;a conflict">
      <bpmn:incoming>f_ff_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_reconcile" name="Reconcile phases with the review files&#10;nightly-batch">
      <bpmn:documentation>presnick/mi-spending:.claude/skills/nightly-batch, Steps 1b to 1e: for every county, check the phase against the review and notes files, advance it on an approval, move it back on a rerun or on an inconsistency, and save the phases.</bpmn:documentation>
      <bpmn:incoming>f_ff_yes</bpmn:incoming>
      <bpmn:outgoing>f_119</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="do_153">
        <bpmn:targetRef>DS_progress_ref</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_n_m">
      <bpmn:incoming>f_119</bpmn:incoming>
      <bpmn:incoming>f_122</bpmn:incoming>
      <bpmn:outgoing>f_120</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_pick" name="Pick the next unblocked county&#10;nightly-batch">
      <bpmn:documentation>presnick/mi-spending:.claude/skills/nightly-batch, Step 2: walk county_queue in order, skipping counties waiting at a gate or complete. Also checks the token budget left in this session.</bpmn:documentation>
      <bpmn:incoming>f_120</bpmn:incoming>
      <bpmn:outgoing>f_121</bpmn:outgoing>
      <bpmn:property id="Property_T_pick" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="di_154">
        <bpmn:sourceRef>DS_progress_ref</bpmn:sourceRef>
        <bpmn:targetRef>Property_T_pick</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_work" name="a county to work on,&#10;and budget left?" default="f_work_no">
      <bpmn:incoming>f_121</bpmn:incoming>
      <bpmn:outgoing>f_work_yes</bpmn:outgoing>
      <bpmn:outgoing>f_work_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_advance" name="Advance it one phase">
      <bpmn:documentation>presnick/mi-spending:.claude/skills/nightly-batch, Step 3: does the work of the county's current phase, which is one stretch of the county pool above, then returns to Step 2.</bpmn:documentation>
      <bpmn:incoming>f_work_yes</bpmn:incoming>
      <bpmn:outgoing>f_122</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_dash" name="Write the pipeline dashboard&#10;nightly-batch">
      <bpmn:documentation>presnick/mi-spending:.claude/skills/nightly-batch, Step 7: presnick/mi-spending:review/pipeline-status.md, the table reporters check to see which counties wait on them. Also rewritten with every review commit.</bpmn:documentation>
      <bpmn:incoming>f_work_no</bpmn:incoming>
      <bpmn:outgoing>f_123</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="do_155">
        <bpmn:targetRef>DOR_dash_124</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_night" name="every county waiting,&#10;done, or out of budget">
      <bpmn:incoming>f_123</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DS_progress_ref" name="pipeline_progress.json" dataStoreRef="DS_progress" />
    <bpmn:dataObjectReference id="DOR_dash_124" name="pipeline-status.md" dataObjectRef="DO_dash" />
    <bpmn:dataObject id="DO_dash" />
    <bpmn:sequenceFlow id="f_116" sourceRef="Start_night" targetRef="T_launch" />
    <bpmn:sequenceFlow id="f_117" sourceRef="T_launch" targetRef="G_clock" />
    <bpmn:sequenceFlow id="f_clock_no" name="no" sourceRef="G_clock" targetRef="End_skip">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">the run fired outside 00:00 to 00:59, e.g. on waking</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_clock_yes" name="yes" sourceRef="G_clock" targetRef="T_pull" />
    <bpmn:sequenceFlow id="f_118" sourceRef="T_pull" targetRef="G_ff" />
    <bpmn:sequenceFlow id="f_ff_no" name="no" sourceRef="G_ff" targetRef="End_conflict">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">local state has diverged from origin/main</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_ff_yes" name="yes" sourceRef="G_ff" targetRef="T_reconcile" />
    <bpmn:sequenceFlow id="f_119" sourceRef="T_reconcile" targetRef="G_n_m" />
    <bpmn:sequenceFlow id="f_122" sourceRef="T_advance" targetRef="G_n_m" />
    <bpmn:sequenceFlow id="f_120" sourceRef="G_n_m" targetRef="T_pick" />
    <bpmn:sequenceFlow id="f_121" sourceRef="T_pick" targetRef="G_work" />
    <bpmn:sequenceFlow id="f_work_yes" name="yes" sourceRef="G_work" targetRef="T_advance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">an unblocked county is left and at least 30,000 tokens remain</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_work_no" name="no" sourceRef="G_work" targetRef="T_dash" />
    <bpmn:sequenceFlow id="f_123" sourceRef="T_dash" targetRef="End_night" />
  </bpmn:process>
