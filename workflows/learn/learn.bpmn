            <bpmn:targetRef>Property_0xzlooz</bpmn:targetRef>
          </bpmn:dataInputAssociation>
          <bpmn:dataInputAssociation id="a_open_notes">
            <bpmn:sourceRef>DOR_s_notes</bpmn:sourceRef>
            <bpmn:targetRef>Property_0xzlooz</bpmn:targetRef>
          </bpmn:dataInputAssociation>
          <bpmn:dataInputAssociation id="a_open_status">
            <bpmn:sourceRef>DOR_s_status</bpmn:sourceRef>
            <bpmn:targetRef>Property_0xzlooz</bpmn:targetRef>
          </bpmn:dataInputAssociation>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="S_merge">
          <bpmn:incoming>s2</bpmn:incoming>
          <bpmn:incoming>s12</bpmn:incoming>
          <bpmn:outgoing>s3</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="S_choose" name="Choose among what the supply offers">
          <bpmn:incoming>s3</bpmn:incoming>
          <bpmn:outgoing>s4</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="S_offerable" name="anything&#10;to run?" default="s16">
          <bpmn:incoming>s4</bpmn:incoming>
          <bpmn:outgoing>s5</bpmn:outgoing>
          <bpmn:outgoing>s16</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:scriptTask id="S_block" name="Say what has to change upstream&#10;record-status.mjs">
          <bpmn:documentation>workflows/learn/tools/record-status.mjs, writing a `blocked` line to this topic&#39;s status log. Two things reach it, and the difference is who has to act. `needs: curation` — every live candidate for this goal has been dropped, or the instances its supply produces are bad; an agent fixes that alone and learn spawns it in the background. `needs: goal-setting` — the criterion turns out to be untestable or to bundle two capabilities; that needs the learner, and goes on their menu. A tutor who wrote neither would leave a goal that cannot be worked on and nothing saying why.</bpmn:documentation>
          <bpmn:incoming>s16</bpmn:incoming>
          <bpmn:outgoing>s15</bpmn:outgoing>
          <bpmn:property id="Property_s_block" name="__targetRef_placeholder" />
          <bpmn:dataInputAssociation id="a_s_block_goals">
            <bpmn:sourceRef>DOR_s_goals_b</bpmn:sourceRef>
            <bpmn:targetRef>Property_s_block</bpmn:targetRef>
          </bpmn:dataInputAssociation>
          <bpmn:dataOutputAssociation id="a_s_block_status">
            <bpmn:targetRef>DOR_s_status_w</bpmn:targetRef>
          </bpmn:dataOutputAssociation>
        </bpmn:scriptTask>
        <bpmn:adHocSubProcess id="S_run" name="Run the activity" ordering="Parallel">
          <bpmn:documentation>workflows/learn/skills/study/references/running-an-activity.md</bpmn:documentation>
          <bpmn:incoming>s5</bpmn:incoming>
          <bpmn:outgoing>s6</bpmn:outgoing>
          <bpmn:property id="Property_1ak8fpd" name="__targetRef_placeholder" />
          <bpmn:dataInputAssociation id="DataInputAssociation_1r6ja31">
            <bpmn:sourceRef>DOR_acts_s</bpmn:sourceRef>
            <bpmn:targetRef>Property_1ak8fpd</bpmn:targetRef>
          </bpmn:dataInputAssociation>
          <bpmn:dataOutputAssociation id="a_s_acts">
            <bpmn:targetRef>DOR_acts_s</bpmn:targetRef>
          </bpmn:dataOutputAssociation>
          <bpmn:laneSet id="LS_run">
            <bpmn:lane id="L_run_h" name="HUMAN operator">
              <bpmn:flowNodeRef>RUN_human</bpmn:flowNodeRef>
            </bpmn:lane>
            <bpmn:lane id="L_run_a" name="AI AGENT">
              <bpmn:flowNodeRef>RUN_agent</bpmn:flowNodeRef>
              <bpmn:flowNodeRef>RUN_served</bpmn:flowNodeRef>
            </bpmn:lane>
          </bpmn:laneSet>
          <bpmn:userTask id="RUN_human" name="Do the activity; ask for help whenever I want it">
            <bpmn:dataOutputAssociation id="a_run_h_notes">
              <bpmn:targetRef>DOR_notes_run</bpmn:targetRef>
            </bpmn:dataOutputAssociation>
          </bpmn:userTask>
          <bpmn:serviceTask id="RUN_agent" name="Run it as written; probe what gets read past; help when asked">
            <bpmn:property id="Property_run_agent" name="__targetRef_placeholder" />
            <bpmn:dataInputAssociation id="a_run_a_acts_in">
              <bpmn:sourceRef>DOR_acts_run</bpmn:sourceRef>
              <bpmn:targetRef>Property_run_agent</bpmn:targetRef>
            </bpmn:dataInputAssociation>
            <bpmn:dataOutputAssociation id="a_run_a_acts_out">
              <bpmn:targetRef>DOR_acts_run</bpmn:targetRef>
            </bpmn:dataOutputAssociation>
            <bpmn:dataOutputAssociation id="a_run_a_notes">
              <bpmn:targetRef>DOR_notes_run</bpmn:targetRef>
            </bpmn:dataOutputAssociation>
          </bpmn:serviceTask>
          <bpmn:scriptTask id="RUN_served" name="What has this already been given?&#10;served.mjs">
            <bpmn:documentation>workflows/learn/tools/served.mjs — the labels this goal has already been given, returned unmodified. A label is whatever the supply that wrote it chose to write, and that supply is the only thing that reads it back: the vocabulary supply writes the move and a note on the instance, the curated supply writes the entry id and a bank item after a slash. Recomputed from the attempt log rather than cached, because a generator&#39;s labels grow for as long as the goal keeps coming back in review.</bpmn:documentation>
            <bpmn:property id="Property_served_tr" name="__targetRef_placeholder" />
            <bpmn:dataInputAssociation id="a_served_log">
              <bpmn:sourceRef>DOR_run_log</bpmn:sourceRef>
              <bpmn:targetRef>Property_served_tr</bpmn:targetRef>
            </bpmn:dataInputAssociation>
          </bpmn:scriptTask>
          <bpmn:dataObjectReference id="DOR_run_log" name="attempts.jsonl" dataObjectRef="DO_log" />
          <bpmn:dataObjectReference id="DOR_notes_run" name="notes.md" dataObjectRef="DO_notes" />
          <bpmn:dataObjectReference id="DOR_acts_run" name="activities.md" dataObjectRef="DO_acts" />
          <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">the learner can attempt the real thing, the attempt is finished, or the activity is abandoned</bpmn:completionCondition>
        </bpmn:adHocSubProcess>
        <bpmn:exclusiveGateway id="S_gate_judge" name="might it&#10;settle anything?" default="s8">
          <bpmn:incoming>s6</bpmn:incoming>
          <bpmn:outgoing>s7</bpmn:outgoing>
          <bpmn:outgoing>s8</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="S_judge" name="Rule on unaided, and on the criterion&#10;the goal&#39;s adjudicator">
          <bpmn:documentation>Whichever implementation the goal&#39;s adjudicator slot names: workflows/learn/skills/study/judge/SKILL.md, a fresh judge in a fresh context, or the tutor ruling in session with no extra call. One contract either way — given the goal, its criterion and the record, rule on each question separately.</bpmn:documentation>
          <bpmn:incoming>s7</bpmn:incoming>
          <bpmn:outgoing>s9</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="S_merge2">
          <bpmn:incoming>s8</bpmn:incoming>
          <bpmn:incoming>s9</bpmn:incoming>
          <bpmn:outgoing>s10</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:scriptTask id="S_log" name="Log the attempt&#10;record-attempt.mjs">
          <bpmn:documentation>workflows/learn/tools/record-attempt.mjs. Every attempt goes through it, missed ones included — nothing can be worked out from a record of only what worked. It checks the goal id against goals.md, stores the two axes raw and collapses nothing, records the label and tags the supply returned, and asks the goal&#39;s own bar of the whole log. It sets no date and writes nowhere else: the schedule is a fold over the file it has just appended to, so recording the attempt is what sets the date.</bpmn:documentation>
          <bpmn:incoming>s10</bpmn:incoming>
          <bpmn:outgoing>s14</bpmn:outgoing>
          <bpmn:property id="Property_s_log" name="__targetRef_placeholder" />
          <bpmn:dataInputAssociation id="a_s_log_read">
            <bpmn:sourceRef>DOR_s_log</bpmn:sourceRef>
            <bpmn:targetRef>Property_s_log</bpmn:targetRef>
          </bpmn:dataInputAssociation>
          <bpmn:dataInputAssociation id="a_s_log_goals">
            <bpmn:sourceRef>DOR_s_goals_l</bpmn:sourceRef>
            <bpmn:targetRef>Property_s_log</bpmn:targetRef>
          </bpmn:dataInputAssociation>
          <bpmn:dataOutputAssociation id="a_s_log">
            <bpmn:targetRef>DOR_s_log</bpmn:targetRef>
          </bpmn:dataOutputAssociation>
        </bpmn:scriptTask>
        <bpmn:exclusiveGateway id="S_merge3">
          <bpmn:incoming>s14</bpmn:incoming>
          <bpmn:incoming>s15</bpmn:incoming>
          <bpmn:outgoing>s11</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:exclusiveGateway id="S_gate_on" name="carry&#10;on?" default="s13">
          <bpmn:incoming>s11</bpmn:incoming>
          <bpmn:outgoing>s12</bpmn:outgoing>
          <bpmn:outgoing>s13</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="End_S" name="session over">
          <bpmn:incoming>s13</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:dataObjectReference id="DOR_s_goals" name="goals.md" dataObjectRef="DO_goals" />
        <bpmn:dataObjectReference id="DOR_s_acts_r" name="activities.md" dataObjectRef="DO_acts" />
        <bpmn:dataObjectReference id="DOR_s_notes" name="notes.md" dataObjectRef="DO_notes" />
        <bpmn:dataObjectReference id="DOR_s_status" name="status.jsonl" dataObjectRef="DO_status" />
        <bpmn:dataObjectReference id="DOR_s_status_w" name="status.jsonl" dataObjectRef="DO_status" />
        <bpmn:dataObjectReference id="DOR_s_goals_b" name="goals.md" dataObjectRef="DO_goals" />
        <bpmn:dataObjectReference id="DOR_acts_s" name="activities.md" dataObjectRef="DO_acts" />
        <bpmn:dataObjectReference id="DOR_s_log" name="attempts.jsonl" dataObjectRef="DO_log" />
        <bpmn:dataObjectReference id="DOR_s_goals_l" name="goals.md" dataObjectRef="DO_goals" />
        <bpmn:sequenceFlow id="s14" sourceRef="S_log" targetRef="S_merge3" />
        <bpmn:sequenceFlow id="s15" sourceRef="S_block" targetRef="S_merge3" />
        <bpmn:sequenceFlow id="s16" name="no" sourceRef="S_offerable" targetRef="S_block" />
        <bpmn:sequenceFlow id="s1" sourceRef="Start_S" targetRef="S_open" />
        <bpmn:sequenceFlow id="s2" sourceRef="S_open" targetRef="S_merge" />
        <bpmn:sequenceFlow id="s3" sourceRef="S_merge" targetRef="S_choose" />
        <bpmn:sequenceFlow id="s4" sourceRef="S_choose" targetRef="S_offerable" />
        <bpmn:sequenceFlow id="s5" name="yes" sourceRef="S_offerable" targetRef="S_run">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">the goal&#39;s supply returned something to run. Otherwise that goal is stuck until something upstream changes, and saying so is the only useful thing left to do with it</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="s6" sourceRef="S_run" targetRef="S_gate_judge" />
        <bpmn:sequenceFlow id="s7" name="yes" sourceRef="S_gate_judge" targetRef="S_judge">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">the attempt might have established something. Otherwise nobody rules, and the honest record is criterion: unchecked</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="s8" name="no" sourceRef="S_gate_judge" targetRef="S_merge2" />
        <bpmn:sequenceFlow id="s9" sourceRef="S_judge" targetRef="S_merge2" />
        <bpmn:sequenceFlow id="s10" sourceRef="S_merge2" targetRef="S_log" />
        <bpmn:sequenceFlow id="s11" sourceRef="S_merge3" targetRef="S_gate_on" />
        <bpmn:sequenceFlow id="s12" name="yes" sourceRef="S_gate_on" targetRef="S_merge">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">the learner wants to keep going</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="s13" name="no" sourceRef="S_gate_on" targetRef="End_S" />
        <bpmn:dataObject id="DO_log" />
      </bpmn:subProcess>
      <bpmn:dataObjectReference id="DOR_t_status_w" name="status.jsonl" dataObjectRef="DO_status" />
      <bpmn:dataObjectReference id="DOR_acts_2" name="activities.md" dataObjectRef="DO_acts" />
      <bpmn:dataObjectReference id="DOR_goals_2" name="goals.md" dataObjectRef="DO_goals" />
      <bpmn:dataObjectReference id="DOR_goals" name="goals.md" dataObjectRef="DO_goals" />
      <bpmn:dataObjectReference id="DOR_t_notes" name="notes.md" dataObjectRef="DO_notes" />
      <bpmn:dataObjectReference id="DOR_t_log" name="attempts.jsonl" dataObjectRef="DO_log" />
      <bpmn:dataObjectReference id="DOR_acts_3" name="activities.md" dataObjectRef="DO_acts" />
      <bpmn:dataObjectReference id="DOR_t_log_in" name="attempts.jsonl" dataObjectRef="DO_log" />
      <bpmn:dataObjectReference id="DOR_t_status" name="status.jsonl" dataObjectRef="DO_status" />
      <bpmn:dataObjectReference id="DOR_t_goals_p" name="goals.md" dataObjectRef="DO_goals" />
      <bpmn:dataObjectReference id="DOR_t_acts_p" name="activities.md" dataObjectRef="DO_acts" />
      <bpmn:dataObjectReference id="DOR_notes" name="notes.md" dataObjectRef="DO_notes" />
      <bpmn:dataObjectReference id="DOR_acts" name="activities.md" dataObjectRef="DO_acts" />
      <bpmn:sequenceFlow id="f_assess" sourceRef="Gate_merge" targetRef="S_phase" />
      <bpmn:sequenceFlow id="f_phase" sourceRef="S_phase" targetRef="Task_topic" />
      <bpmn:sequenceFlow id="f_routed" sourceRef="Task_topic" targetRef="Gate_route" />
      <bpmn:sequenceFlow id="f_goals" name="goals" sourceRef="Gate_route" targetRef="Conv_goals">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">goals.md has no goal in the default group; or Stuck says this topic needs goal setting; or every required goal is met and the learner is here, because adding to a finished topic is what they came for</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="f_curate" name="activities" sourceRef="Gate_route" targetRef="Sub_curate">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">a goal has no live candidate left in activities.md</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="f_study" name="learning" sourceRef="Gate_route" targetRef="Sub_learn">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">a goal is unmet and has a live activity</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="f_nothing" name="nothing" sourceRef="Gate_route" targetRef="End_T" />
      <bpmn:sequenceFlow id="f_goalsback" sourceRef="Conv_goals" targetRef="Gate_merge" />
      <bpmn:sequenceFlow id="f_curateback" sourceRef="Sub_curate" targetRef="Gate_merge" />
      <bpmn:sequenceFlow id="f_learnback" sourceRef="Sub_learn" targetRef="Gate_merge" />
      <bpmn:dataObject id="DO_acts" />
      <bpmn:dataObject id="DO_goals" />
      <bpmn:dataObject id="DO_notes" />
      <bpmn:dataObject id="DO_status" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Conv_review" name="Review">
      <bpmn:documentation>workflows/learn/skills/review/SKILL.md</bpmn:documentation>
      <bpmn:incoming>f_review</bpmn:incoming>
      <bpmn:outgoing>f_reviewback</bpmn:outgoing>
      <bpmn:laneSet id="LS_review">
        <bpmn:lane id="L_rev_h" name="HUMAN operator">
          <bpmn:flowNodeRef>R_attempt</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R_post</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_R</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="L_rev_a" name="AI AGENT">
          <bpmn:flowNodeRef>Start_R</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R_setup</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R_merge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R_judge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R_merge2</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R_stuck</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R_checkable</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R_another</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="L_rev_p" name="PROGRAM">
          <bpmn:flowNodeRef>R_due</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R_record</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R_block</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="Start_R" name="the learner chose&#10;a review sitting">
        <bpmn:outgoing>r1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:scriptTask id="R_due" name="Find what is due, across every topic&#10;review-due.mjs">
        <bpmn:documentation>workflows/learn/tools/review-due.mjs — run here even though the menu already ran it. Nothing is handed down; a list that arrived with the learner could be about a different topic or an hour out of date. It takes no arguments and reads the same three files wherever it is run: goals.md for each goal and its slots, attempts.jsonl to fold out when each one next comes due, and status.jsonl to skip what the learner gave up — a whole topic, or a single goal inside one they are still working on. There is no review.json to read — the schedule is not stored anywhere.</bpmn:documentation>
        <bpmn:incoming>r1</bpmn:incoming>
        <bpmn:outgoing>r0</bpmn:outgoing>
        <bpmn:property id="Property_r_due" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="a_r_due_goals">
          <bpmn:sourceRef>DOR_r_goals_in</bpmn:sourceRef>
          <bpmn:targetRef>Property_r_due</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="a_r_due_log">
          <bpmn:sourceRef>DOR_r_log_in</bpmn:sourceRef>
          <bpmn:targetRef>Property_r_due</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="a_r_due_status">
          <bpmn:sourceRef>DOR_r_status</bpmn:sourceRef>
          <bpmn:targetRef>Property_r_due</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:scriptTask>
      <bpmn:serviceTask id="R_setup" name="Set the task — whatever the goal&#39;s supply returns">
        <bpmn:incoming>Flow_0ybsgz2</bpmn:incoming>
        <bpmn:outgoing>Flow_0zf28qi</bpmn:outgoing>
        <bpmn:property id="Property_04229ld" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="a_r_setup_acts">
          <bpmn:sourceRef>DOR_r_acts</bpmn:sourceRef>
          <bpmn:targetRef>Property_04229ld</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="a_r_setup_goals">
          <bpmn:sourceRef>DOR_r_goals</bpmn:sourceRef>
          <bpmn:targetRef>Property_04229ld</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="R_checkable" name="anything to&#10;check with?" default="r13">
        <bpmn:incoming>Flow_0zf28qi</bpmn:incoming>
        <bpmn:outgoing>r15</bpmn:outgoing>
        <bpmn:outgoing>r13</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="R_block" name="Say the goal has nothing to check it&#10;record-status.mjs">
        <bpmn:documentation>workflows/learn/tools/record-status.mjs, writing `blocked … needs: curation`. A goal reached review with no live entry in activities.md that checks it — usually the entry it passed was dropped afterwards. There is nothing to adjudicate and nothing to record, and the date stays where it is, so the goal is still due once there is something to check it with. Without this line nothing would ever build one: curation runs on the queue, and this is what puts it there.</bpmn:documentation>
        <bpmn:incoming>r13</bpmn:incoming>
        <bpmn:outgoing>r14</bpmn:outgoing>
        <bpmn:property id="Property_r_block" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="a_r_block_goals">
          <bpmn:sourceRef>DOR_r_goals_b</bpmn:sourceRef>
          <bpmn:targetRef>Property_r_block</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="a_r_block_status">
          <bpmn:targetRef>DOR_r_status_w</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="R_merge">
        <bpmn:incoming>r11</bpmn:incoming>
        <bpmn:incoming>r0</bpmn:incoming>
        <bpmn:outgoing>Flow_0ybsgz2</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="R_attempt" name="Attempt it cold, with no help offered">
        <bpmn:incoming>Flow_0zf28qi</bpmn:incoming>
        <bpmn:outgoing>r4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="R_judge" name="Rule on unaided, and on the criterion&#10;the goal&#39;s adjudicator">
        <bpmn:documentation>Whichever implementation the goal&#39;s adjudicator slot names — the same one the first pass used. Nearly always workflows/learn/skills/study/judge/SKILL.md here: a goal whose adjudicator is the tutor usually carries recurrence: never and does not come back at all.</bpmn:documentation>
        <bpmn:incoming>r4</bpmn:incoming>
        <bpmn:outgoing>r5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="R_stuck" name="correct?" default="r8">
        <bpmn:incoming>r9</bpmn:incoming>
        <bpmn:outgoing>r6</bpmn:outgoing>
        <bpmn:outgoing>r8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="R_post" name="Go over what happened; optionally edit notes">
        <bpmn:incoming>r6</bpmn:incoming>
        <bpmn:outgoing>r7</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="a_r_post_notes">
          <bpmn:targetRef>DOR_r_notes</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:task>
      <bpmn:exclusiveGateway id="R_merge2">
        <bpmn:incoming>r7</bpmn:incoming>
        <bpmn:incoming>r8</bpmn:incoming>
        <bpmn:incoming>r14</bpmn:incoming>
        <bpmn:outgoing>r10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="R_record" name="Record the attempt; the same call moves the date&#10;record-attempt.mjs">
        <bpmn:documentation>workflows/learn/tools/record-attempt.mjs, with --source review. It appends one line and writes nowhere else: the next date is a fold over the file it has just appended to, so recording the attempt IS setting the date, and there is no second write for a session to forget. --source review is what makes this attempt one the fold moves the date on.</bpmn:documentation>
        <bpmn:incoming>r5</bpmn:incoming>
        <bpmn:outgoing>r9</bpmn:outgoing>
        <bpmn:property id="Property_r_rec" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="a_r_record_read">
          <bpmn:sourceRef>DOR_r_log</bpmn:sourceRef>
          <bpmn:targetRef>Property_r_rec</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="a_r_record_goals">
          <bpmn:sourceRef>DOR_r_goals_rec</bpmn:sourceRef>
          <bpmn:targetRef>Property_r_rec</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="a_r_record_log">
          <bpmn:targetRef>DOR_r_log</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="R_another" name="more on&#10;the list?" default="r12">
        <bpmn:incoming>r10</bpmn:incoming>
        <bpmn:outgoing>r11</bpmn:outgoing>
        <bpmn:outgoing>r12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_R" name="nothing&#10;more due">
        <bpmn:incoming>r12</bpmn:incoming>
      </bpmn:endEvent>
