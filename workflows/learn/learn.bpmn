          <bpmn:outgoing>g_s6</bpmn:outgoing>
          <bpmn:outgoing>g_s5</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="G_critique" name="Critique the goals, in a fresh context&#10;goal-setting/critique">
          <bpmn:documentation>workflows/learn/skills/goal-setting/critique/SKILL.md</bpmn:documentation>
          <bpmn:incoming>g_s6</bpmn:incoming>
          <bpmn:outgoing>g_s7</bpmn:outgoing>
          <bpmn:property id="Property_g_crit" name="__targetRef_placeholder" />
          <bpmn:dataInputAssociation id="a_crit_goals">
