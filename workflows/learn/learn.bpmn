        <bpmn:endEvent id="End_G" name="goals settled">
          <bpmn:incoming>g_s5</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:dataObjectReference id="DOR_goals_in" name="goals.md" dataObjectRef="DO_goals" />
        <bpmn:sequenceFlow id="g_s1" sourceRef="Start_G" targetRef="G_merge" />
        <bpmn:sequenceFlow id="g_s2" sourceRef="G_merge" targetRef="Sub_fill" />
        <bpmn:sequenceFlow id="g_s3" sourceRef="Sub_fill" targetRef="G_offer" />
