          <bpmn:laneSet id="LS_fill">
            <bpmn:lane id="L_fill_h" name="HUMAN operator">
              <bpmn:flowNodeRef>FILL_human</bpmn:flowNodeRef>
            </bpmn:lane>
            <bpmn:lane id="L_fill_a" name="AI AGENT">
              <bpmn:flowNodeRef>FILL_agent</bpmn:flowNodeRef>
            </bpmn:lane>
          </bpmn:laneSet>
          <bpmn:userTask id="FILL_human" name="State what it is for; propose criteria; reject criteria that aren&#39;t checkable">
            <bpmn:dataOutputAssociation id="a_conv_h_goals">
              <bpmn:targetRef>DOR_goals_conv</bpmn:targetRef>
            </bpmn:dataOutputAssociation>
          </bpmn:userTask>
          <bpmn:serviceTask id="FILL_agent" name="Ask, probe, propose criteria. Do not teach the subject yet">
            <bpmn:dataOutputAssociation id="a_conv_a_goals">
              <bpmn:targetRef>DOR_goals_conv</bpmn:targetRef>
            </bpmn:dataOutputAssociation>
          </bpmn:serviceTask>
          <bpmn:dataObjectReference id="DOR_goals_conv" name="goals.md" dataObjectRef="DO_goals" />
          <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">the learner stops editing goals.md</bpmn:completionCondition>
        </bpmn:adHocSubProcess>
        <bpmn:serviceTask id="G_offer" name="When possibly done, offer an outside critique&#10;goal-setting">
          <bpmn:documentation>workflows/learn/skills/goal-setting/SKILL.md</bpmn:documentation>
