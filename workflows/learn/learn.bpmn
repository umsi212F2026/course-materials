<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_v2" targetNamespace="http://si212.umich.edu/schema/bpmn">
  <bpmn:collaboration id="C_1">
    <bpmn:participant id="P_1" name="Teaching yourself something — one sitting" processRef="Proc_1" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_1" name="Teaching yourself something" isExecutable="false">
    <bpmn:laneSet id="LS_1">
      <bpmn:lane id="L_human" name="HUMAN operator">
        <bpmn:flowNodeRef>End_ended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_program" name="PROGRAM" />
      <bpmn:lane id="L_agent" name="AI AGENT">
        <bpmn:flowNodeRef>Gate_entry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_topic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Conv_review</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="f_start" sourceRef="Start_1" targetRef="Gate_entry" />
    <bpmn:sequenceFlow id="f_enter" sourceRef="Gate_entry" targetRef="Sub_select" />
    <bpmn:sequenceFlow id="f_chosen" sourceRef="Sub_select" targetRef="Gate_done" />
    <bpmn:sequenceFlow id="f_sel" name="work on a topic" sourceRef="Gate_done" targetRef="Sub_topic">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">the learner named a topic to work on</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_topicback" sourceRef="Sub_topic" targetRef="Gate_entry" />
    <bpmn:sequenceFlow id="f_notsel" name="done" sourceRef="Gate_done" targetRef="End_ended" />
    <bpmn:sequenceFlow id="f_reviewback" sourceRef="Conv_review" targetRef="Gate_entry" />
    <bpmn:sequenceFlow id="f_review" name="review" sourceRef="Gate_done" targetRef="Conv_review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">the learner chose to work through whatever has come due, which is not a topic and never one topic</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gate_entry">
      <bpmn:incoming>f_start</bpmn:incoming>
      <bpmn:incoming>f_topicback</bpmn:incoming>
      <bpmn:incoming>f_reviewback</bpmn:incoming>
      <bpmn:outgoing>f_enter</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_done" name="what did&#10;they choose?" default="f_notsel">
      <bpmn:incoming>f_chosen</bpmn:incoming>
      <bpmn:outgoing>f_sel</bpmn:outgoing>
      <bpmn:outgoing>f_review</bpmn:outgoing>
      <bpmn:outgoing>f_notsel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ended" name="no more&#10;topics today">
      <bpmn:incoming>f_notsel</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_1" name="sits down&#10;to learn">
      <bpmn:outgoing>f_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Sub_select" name="Take stock and choose">
      <bpmn:documentation>workflows/learn/skills/learn/SKILL.md — guide: workflows/learn/guides/learn/howto.md</bpmn:documentation>
      <bpmn:incoming>f_enter</bpmn:incoming>
      <bpmn:outgoing>f_chosen</bpmn:outgoing>
      <bpmn:laneSet id="LS_select">
        <bpmn:lane id="L_select_h" name="HUMAN operator">
          <bpmn:flowNodeRef>End_L</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Start_L</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_add</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_ldiscuss</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_lend</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_human_role</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="L_select_a" name="AI AGENT">
          <bpmn:flowNodeRef>L_spawn</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_lmerge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_agent_role</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_lwhat</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="L_select_p" name="PROGRAM">
          <bpmn:flowNodeRef>L_assemble</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_due</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_lsplit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_report</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G_ljoin</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_mkdir</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>L_word</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="Start_L" name="skill invoked&#10;learn">
        <bpmn:documentation>workflows/learn/skills/learn/SKILL.md</bpmn:documentation>
        <bpmn:outgoing>l1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="G_lsplit">
        <bpmn:incoming>l1</bpmn:incoming>
        <bpmn:outgoing>l2</bpmn:outgoing>
        <bpmn:outgoing>l3</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:scriptTask id="L_assemble" name="Read every topic folder&#10;survey.mjs">
        <bpmn:documentation>workflows/learn/tools/survey.mjs</bpmn:documentation>
        <bpmn:incoming>l2</bpmn:incoming>
        <bpmn:outgoing>l4</bpmn:outgoing>
        <bpmn:property id="Property_l_asm" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="a_l_folders">
          <bpmn:sourceRef>DOR_l_folders</bpmn:sourceRef>
          <bpmn:targetRef>Property_l_asm</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="L_due" name="Count what is due across all topics&#10;review-due.mjs">
        <bpmn:documentation>workflows/learn/tools/review-due.mjs — the menu needs the count and roughly where they are, not the list. Review runs the same program itself and is handed nothing, so a list can&#39;t travel with the learner and go stale on the way. It takes no arguments and reads the same three files wherever it is run — the review plane draws the identical set.</bpmn:documentation>
        <bpmn:incoming>l3</bpmn:incoming>
        <bpmn:outgoing>l5</bpmn:outgoing>
        <bpmn:property id="Property_l_due" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="a_l_due_goals">
          <bpmn:sourceRef>DOR_l_goals_d</bpmn:sourceRef>
          <bpmn:targetRef>Property_l_due</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="a_l_due_log">
          <bpmn:sourceRef>DOR_l_log</bpmn:sourceRef>
          <bpmn:targetRef>Property_l_due</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="a_l_due_status">
          <bpmn:sourceRef>DOR_l_status_d</bpmn:sourceRef>
          <bpmn:targetRef>Property_l_due</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:scriptTask>
      <bpmn:parallelGateway id="G_ljoin">
        <bpmn:incoming>l4</bpmn:incoming>
        <bpmn:incoming>l5</bpmn:incoming>
        <bpmn:outgoing>l6</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:serviceTask id="L_spawn" name="Start the work that needs no learner&#10;topic">
        <bpmn:documentation>workflows/learn/skills/topic/SKILL.md, spawned in the background, once per topic carrying an outstanding item whose `needs` is curation. That is the whole test and it needs no judgement: the status log says what is waiting and who for. It catches the case nothing else did — goal setting finished, the session ended before curation ran, and nobody wrote a note saying so. Spawn and carry on: the learner is here wanting to do something, and a generate pass and two checks are a bad thing to make them watch.</bpmn:documentation>
        <bpmn:incoming>l6</bpmn:incoming>
        <bpmn:outgoing>l20</bpmn:outgoing>
        <bpmn:property id="Property_l_spawn" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="a_l_spawn_status">
          <bpmn:sourceRef>DOR_l_status</bpmn:sourceRef>
          <bpmn:targetRef>Property_l_spawn</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_lmerge">
        <bpmn:incoming>l20</bpmn:incoming>
        <bpmn:incoming>l16</bpmn:incoming>
        <bpmn:incoming>Flow_1plhddl</bpmn:incoming>
        <bpmn:incoming>Flow_0l1rwug</bpmn:incoming>
        <bpmn:outgoing>l7</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="L_agent_role" name="Offer a menu">
        <bpmn:incoming>l7</bpmn:incoming>
        <bpmn:outgoing>l8</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="L_human_role" name="Choose">
        <bpmn:incoming>l8</bpmn:incoming>
        <bpmn:outgoing>l9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_ldiscuss" name="choice?" default="l12">
        <bpmn:incoming>l9</bpmn:incoming>
        <bpmn:outgoing>l10</bpmn:outgoing>
        <bpmn:outgoing>l15</bpmn:outgoing>
        <bpmn:outgoing>l12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="L_report" name="Summarize where every topic stands&#10;survey.mjs --report">
        <bpmn:documentation>workflows/learn/tools/survey.mjs --report</bpmn:documentation>
        <bpmn:incoming>l15</bpmn:incoming>
        <bpmn:outgoing>l16</bpmn:outgoing>
        <bpmn:property id="Property_l_rep" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="a_l_report_folders">
          <bpmn:sourceRef>DOR_l_folders_r</bpmn:sourceRef>
          <bpmn:targetRef>Property_l_rep</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:scriptTask>
      <bpmn:task id="L_add" name="Name it and list its starting vocabulary&#10;add-topic">
        <bpmn:documentation>workflows/learn/skills/add-topic/SKILL.md — the conversation only. It writes nothing itself; it works out which of the three cases this is and runs the matching command. It opens with the read drawn here: the goals in every learning/*/goals.md, the word entries especially, because usually a new topic is not what they need.</bpmn:documentation>
        <bpmn:incoming>l10</bpmn:incoming>
        <bpmn:outgoing>l13</bpmn:outgoing>
        <bpmn:property id="Property_l_add" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="a_l_add_goals">
          <bpmn:sourceRef>DOR_l_goals_a</bpmn:sourceRef>
          <bpmn:targetRef>Property_l_add</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:task>
      <bpmn:exclusiveGateway id="G_lwhat" name="which is it?" default="l19">
        <bpmn:incoming>l13</bpmn:incoming>
        <bpmn:outgoing>l17</bpmn:outgoing>
        <bpmn:outgoing>l18</bpmn:outgoing>
        <bpmn:outgoing>l19</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="L_word" name="Add the word to a topic they have&#10;new-word.mjs">
        <bpmn:documentation>workflows/learn/tools/new-word.mjs — the commonest outcome by far, and the reason to write it before new-topic.mjs</bpmn:documentation>
        <bpmn:incoming>l17</bpmn:incoming>
        <bpmn:outgoing>Flow_1plhddl</bpmn:outgoing>
        <bpmn:property id="Property_l_word" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="a_l_word_goals_in">
          <bpmn:sourceRef>DOR_l_goals_w</bpmn:sourceRef>
          <bpmn:targetRef>Property_l_word</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="a_l_word_goals">
          <bpmn:targetRef>DOR_l_goals_w</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="L_mkdir" name="Create the topic folder&#10;new-topic.mjs">
        <bpmn:documentation>workflows/learn/tools/new-topic.mjs</bpmn:documentation>
        <bpmn:incoming>l18</bpmn:incoming>
        <bpmn:outgoing>Flow_0l1rwug</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="a_l_mkdir_folder">
          <bpmn:targetRef>DOR_l_folder_new</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="G_lend">
        <bpmn:incoming>l12</bpmn:incoming>
        <bpmn:incoming>l19</bpmn:incoming>
        <bpmn:outgoing>l21</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_L" name="choice made">
        <bpmn:incoming>l21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:dataObjectReference id="DOR_l_folders_r" name="topic folder" dataObjectRef="DO_folders" />
      <bpmn:dataObjectReference id="DOR_l_folders" name="topic folder" dataObjectRef="DO_folders" />
      <bpmn:dataObjectReference id="DOR_l_goals_d" name="goals.md" dataObjectRef="DO_goals" />
      <bpmn:dataObjectReference id="DOR_l_log" name="attempts.jsonl" dataObjectRef="DO_log" />
      <bpmn:dataObjectReference id="DOR_l_status_d" name="status.jsonl" dataObjectRef="DO_status" />
      <bpmn:dataObjectReference id="DOR_l_status" name="status.jsonl" dataObjectRef="DO_status" />
      <bpmn:dataObjectReference id="DOR_l_goals_a" name="goals.md" dataObjectRef="DO_goals" />
      <bpmn:dataObjectReference id="DOR_l_goals_w" name="goals.md" dataObjectRef="DO_goals" />
      <bpmn:dataObjectReference id="DOR_l_folder_new" name="topic folder" dataObjectRef="DO_folders" />
      <bpmn:dataObject id="DO_folders" />
      <bpmn:sequenceFlow id="l1" sourceRef="Start_L" targetRef="G_lsplit" />
      <bpmn:sequenceFlow id="l2" sourceRef="G_lsplit" targetRef="L_assemble" />
      <bpmn:sequenceFlow id="l3" sourceRef="G_lsplit" targetRef="L_due" />
      <bpmn:sequenceFlow id="l4" sourceRef="L_assemble" targetRef="G_ljoin" />
      <bpmn:sequenceFlow id="l5" sourceRef="L_due" targetRef="G_ljoin" />
      <bpmn:sequenceFlow id="l6" sourceRef="G_ljoin" targetRef="L_spawn" />
      <bpmn:sequenceFlow id="l20" sourceRef="L_spawn" targetRef="G_lmerge" />
      <bpmn:sequenceFlow id="l7" sourceRef="G_lmerge" targetRef="L_agent_role" />
      <bpmn:sequenceFlow id="l8" sourceRef="L_agent_role" targetRef="L_human_role" />
      <bpmn:sequenceFlow id="l9" sourceRef="L_human_role" targetRef="G_ldiscuss" />
      <bpmn:sequenceFlow id="l10" name="add a topic" sourceRef="G_ldiscuss" targetRef="L_add">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">the learner named something that has no folder yet</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="l13" sourceRef="L_add" targetRef="G_lwhat" />
      <bpmn:sequenceFlow id="l17" name="a word for a topic they have" sourceRef="G_lwhat" targetRef="L_word">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">what they named belongs in a topic that already exists</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="l18" name="a new topic" sourceRef="G_lwhat" targetRef="L_mkdir">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">genuinely new — no folder, and not a word for one they have</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="l19" name="they already have the topic" sourceRef="G_lwhat" targetRef="G_lend" />
      <bpmn:sequenceFlow id="l21" sourceRef="G_lend" targetRef="End_L" />
      <bpmn:sequenceFlow id="l12" name="a topic, a review sitting,&#10;or done" sourceRef="G_ldiscuss" targetRef="G_lend" />
      <bpmn:sequenceFlow id="l15" name="show overall progress" sourceRef="G_ldiscuss" targetRef="L_report">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">the learner asked where they stand across every topic</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="l16" sourceRef="L_report" targetRef="G_lmerge" />
      <bpmn:sequenceFlow id="Flow_1plhddl" sourceRef="L_word" targetRef="G_lmerge" />
      <bpmn:sequenceFlow id="Flow_0l1rwug" sourceRef="L_mkdir" targetRef="G_lmerge" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_topic" name="Work on a topic">
      <bpmn:documentation>workflows/learn/skills/topic/SKILL.md — one topic, until there is nothing more to do on it today. Everything inside is about this topic; a review sitting is not, which is why it is not in here.</bpmn:documentation>
      <bpmn:incoming>f_sel</bpmn:incoming>
      <bpmn:outgoing>f_topicback</bpmn:outgoing>
      <bpmn:laneSet id="LS_topic">
        <bpmn:lane id="L_top_p" name="PROGRAM">
          <bpmn:flowNodeRef>End_T</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S_phase</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="L_top_a" name="AI AGENT">
          <bpmn:flowNodeRef>Start_T</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gate_merge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_topic</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gate_route</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Sub_curate</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="L_top_h" name="HUMAN operator">
          <bpmn:flowNodeRef>Conv_goals</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Sub_learn</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="Start_T" name="a topic was chosen">
        <bpmn:outgoing>t_start</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="End_T" name="nothing more&#10;to do on it today">
        <bpmn:incoming>f_nothing</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="t_start" sourceRef="Start_T" targetRef="Gate_merge" />
      <bpmn:exclusiveGateway id="Gate_merge">
        <bpmn:incoming>t_start</bpmn:incoming>
        <bpmn:incoming>f_goalsback</bpmn:incoming>
        <bpmn:incoming>f_curateback</bpmn:incoming>
        <bpmn:incoming>f_learnback</bpmn:incoming>
        <bpmn:outgoing>f_assess</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="S_phase" name="Derive the phase and what is outstanding&#10;survey.mjs">
        <bpmn:documentation>workflows/learn/tools/survey.mjs — one derivation, run here and by the menu, so that topic, learn and the progress report cannot drift apart. It reads all four files drawn here, and needs all four: goals.md for the goals and their slots, activities.md for which entries are still live, attempts.jsonl to ask each goal&#39;s own bar of the whole history, and status.jsonl for what is outstanding and whether the topic was given up. A stored phase could contradict the files; this cannot.</bpmn:documentation>
        <bpmn:incoming>f_assess</bpmn:incoming>
        <bpmn:outgoing>f_phase</bpmn:outgoing>
        <bpmn:property id="Property_phase_tr" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="a_phase_status">
          <bpmn:sourceRef>DOR_t_status</bpmn:sourceRef>
          <bpmn:targetRef>Property_phase_tr</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="a_phase_log">
          <bpmn:sourceRef>DOR_t_log_in</bpmn:sourceRef>
          <bpmn:targetRef>Property_phase_tr</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="a_phase_goals">
          <bpmn:sourceRef>DOR_t_goals_p</bpmn:sourceRef>
          <bpmn:targetRef>Property_phase_tr</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="a_phase_acts">
          <bpmn:sourceRef>DOR_t_acts_p</bpmn:sourceRef>
          <bpmn:targetRef>Property_phase_tr</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:scriptTask>
      <bpmn:serviceTask id="Task_topic" name="Decide what this topic needs&#10;topic">
        <bpmn:documentation>workflows/learn/skills/topic/SKILL.md</bpmn:documentation>
        <bpmn:incoming>f_phase</bpmn:incoming>
        <bpmn:outgoing>f_routed</bpmn:outgoing>
        <bpmn:property id="Property_0fbprlw" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="a_topic_acts">
          <bpmn:sourceRef>DOR_acts_3</bpmn:sourceRef>
          <bpmn:targetRef>Property_0fbprlw</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="a_topic_notes">
          <bpmn:sourceRef>DOR_t_notes</bpmn:sourceRef>
          <bpmn:targetRef>Property_0fbprlw</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gate_route" name="what does&#10;topic need?" default="f_nothing">
        <bpmn:incoming>f_routed</bpmn:incoming>
        <bpmn:outgoing>f_goals</bpmn:outgoing>
        <bpmn:outgoing>f_curate</bpmn:outgoing>
        <bpmn:outgoing>f_study</bpmn:outgoing>
        <bpmn:outgoing>f_nothing</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:subProcess id="Conv_goals" name="Set goals">
