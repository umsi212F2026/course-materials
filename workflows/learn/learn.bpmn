      <bpmn:sequenceFlow id="r6" name="no" sourceRef="R_stuck" targetRef="R_post">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">the judge did not find the criterion met</bpmn:conditionExpression>
