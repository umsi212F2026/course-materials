<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="tracker" name="Postings tracker" processRef="tracker_process" />
  </bpmn:collaboration>
  <bpmn:process id="tracker_process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_human" name="HUMAN operator">
        <bpmn:flowNodeRef>posting_saved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review_verdict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>worth_applying</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>posting_tracked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>posting_dropped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_agent" name="AI AGENT">
        <bpmn:flowNodeRef>merge_assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess_posting</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_program" name="PROGRAM">
        <bpmn:flowNodeRef>fetch_posting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="posting_saved" name="posting link saved">
      <bpmn:outgoing>to_fetch</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="fetch_posting" name="Fetch posting">
      <bpmn:incoming>to_fetch</bpmn:incoming>
      <bpmn:outgoing>to_merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="merge_assess">
      <bpmn:incoming>to_merge</bpmn:incoming>
      <bpmn:incoming>rerun</bpmn:incoming>
      <bpmn:outgoing>to_assess</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="assess_posting" name="Assess posting">
      <bpmn:incoming>to_assess</bpmn:incoming>
      <bpmn:outgoing>to_review</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="assess_writes_postings">
        <bpmn:targetRef>postings_store</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:userTask id="review_verdict" name="Review verdict">
      <bpmn:incoming>to_review</bpmn:incoming>
      <bpmn:outgoing>to_decide</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="worth_applying" name="worth applying?">
      <bpmn:incoming>to_decide</bpmn:incoming>
      <bpmn:outgoing>yes</bpmn:outgoing>
      <bpmn:outgoing>no</bpmn:outgoing>
      <bpmn:outgoing>rerun</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="posting_tracked" name="posting tracked">
      <bpmn:incoming>yes</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="posting_dropped" name="posting dropped">
      <bpmn:incoming>no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="postings_store" name="postings.csv" />
    <bpmn:sequenceFlow id="to_fetch" sourceRef="posting_saved" targetRef="fetch_posting" />
    <bpmn:sequenceFlow id="to_merge" sourceRef="fetch_posting" targetRef="merge_assess" />
    <bpmn:sequenceFlow id="to_assess" sourceRef="merge_assess" targetRef="assess_posting" />
    <bpmn:sequenceFlow id="to_review" sourceRef="assess_posting" targetRef="review_verdict" />
    <bpmn:sequenceFlow id="to_decide" sourceRef="review_verdict" targetRef="worth_applying" />
    <bpmn:sequenceFlow id="yes" name="yes" sourceRef="worth_applying" targetRef="posting_tracked" />
    <bpmn:sequenceFlow id="no" name="no" sourceRef="worth_applying" targetRef="posting_dropped" />
    <bpmn:sequenceFlow id="rerun" name="verdict looks wrong" sourceRef="worth_applying" targetRef="merge_assess" />
  </bpmn:process>
</bpmn:definitions>
